name: Scheduled merge - Character Spotlight Launch

on:
  schedule:
    # Runs at 11:55 UTC on January 30, 2026 (12:55 CET)
    - cron: '55 11 30 1 *'
  workflow_dispatch: # Allows manual trigger for testing

jobs:
  merge:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
          token: ${{ secrets.GITHUB_TOKEN }}
      
      - name: Configure Git
        run: |
          git config user.name "GitHub Actions Bot"
          git config user.email "actions@github.com"
      
      - name: Merge feature branch to main
        run: |
          git checkout main
          git pull origin main
          git merge origin/feature/character-spotlights --no-ff -m "Launch: Henry's Character Spotlight - Automated merge from feature/character-spotlights"
          git push origin main
      
      - name: Notify on success
        if: success()
        run: |
          echo "✅ Successfully merged feature/character-spotlights to main"
          echo "🚀 Character Spotlight is now live!"
      
      - name: Notify on failure
        if: failure()
        run: |
          echo "❌ Merge failed! Manual intervention required."
          exit 1
